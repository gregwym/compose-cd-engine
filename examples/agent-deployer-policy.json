{
  "workspace": "/volume1/compose-deployer-private",
  "storage": {
    "config": {
      "path": "/volume1/compose-app-config",
      "shared": false,
      "uid": 10001,
      "gid": 10001
    },
    "downloads": {
      "path": "/volume1/compose-downloads",
      "shared": true,
      "uid": 10001,
      "gid": 10001
    }
  },
  "images": {
    "ghcr.io/example/app": {
      "digests": [],
      "allow_unsigned": false,
      "healthcheck": [
        "/usr/local/bin/application-readiness-check"
      ],
      "environment": [
        "TZ",
        "APP_PASSWORD"
      ],
      "identity": "https://github.com/example/app/.github/workflows/build.yml@refs/heads/main",
      "issuer": "https://token.actions.githubusercontent.com",
      "platform": "linux/amd64"
    }
  },
  "port_range": [
    20000,
    20099
  ],
  "bind_ip": "192.168.50.10",
  "max_projects": 8,
  "max_services": 8,
  "max_memory_mb": 2048,
  "max_cpus": 4,
  "max_pids": 128,
  "health_timeout": 180,
  "enabled": false,
  "allow_egress": false,
  "operations": [
    "plan",
    "apply",
    "task",
    "status",
    "start",
    "stop",
    "restart",
    "grant_request",
    "grant_status",
    "grants",
    "projects",
    "diagnose",
    "retire"
  ],
  "authorization": {
    "socket": "/run/compose-cd-approval/approval.sock",
    "service_key": "/etc/compose-cd/secrets/approval-service.key",
    "agents": {
      "openclaw": "/etc/compose-cd/agent-keys/openclaw.key"
    }
  },
  "verification": {
    "socket": "/run/compose-cd-verification/verifier.sock",
    "service_key": "/etc/compose-cd/secrets/verification-service.key"
  }
}
